generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS (must match @repo/shared exactly)
// =============================================================================

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
  OPERATIONS_MANAGER
}

enum DriverAvailability {
  ONLINE
  OFFLINE
  ON_DELIVERY
}

// =============================================================================
// IDENTITY
// =============================================================================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String
  role            Role
  isActive        Boolean   @default(true)
  isSuspended     Boolean   @default(false)
  emailVerifiedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cancelledDeliveries Delivery[] @relation("CancelledByUser")

  customerProfile CustomerProfile?
  driverProfile   DriverProfile?
  addresses       Address[]
  refreshTokens   RefreshToken[]
  notifications   Notification[]
  auditLogs       AuditLog[]        @relation("ActorAuditLogs")

  @@index([role])
  @@index([deletedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

// =============================================================================
// PROFILES
// =============================================================================

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries     Delivery[]  @relation("CustomerDeliveries")
  ratingsGiven   Rating[]    @relation("RatingsByCustomer")
}

model DriverProfile {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  avatarUrl       String?
  availability    DriverAvailability @default(OFFLINE)
  approvalStatus  String             @default("PENDING")
  rating          Decimal            @default(5.0) @db.Decimal(3, 2)
  totalDeliveries Int                @default(0)
  currentLat      Float?
  currentLng      Float?
  lastLocationAt  DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deliveries     Delivery[]  @relation("DriverDeliveries")
  ratingsReceived Rating[]   @relation("RatingsForDriver")

  vehicles  Vehicle[]
  documents DriverDocument[]

  @@index([availability])
  @@index([approvalStatus])
}

model Vehicle {
  id          String        @id @default(uuid())
  driverId    String
  driver      DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type        String
  plateNumber String
  capacityKg  Float?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  @@index([driverId])
}

model DriverDocument {
  id         String        @id @default(uuid())
  driverId   String
  driver     DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type       String
  fileUrl    String
  status     String        @default("PENDING")
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([driverId])
  @@index([status])
}

// =============================================================================
// ADDRESSES
// =============================================================================

model Address {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  line1     String
  city      String
  region    String?
  country   String
  lat       Float
  lng       Float
  isDefault Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, isDefault])
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  channel   String    @default("IN_APP")
  status    String    @default("PENDING")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, status])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// =============================================================================
// AUDIT
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// =============================================================================
// DELIVERY ENUMS
// =============================================================================

enum DeliveryStatus {
  PENDING
  CONFIRMED
  SEARCHING_FOR_DRIVER
  DRIVER_ASSIGNED
  DRIVER_ACCEPTED
  DRIVER_EN_ROUTE_TO_PICKUP
  ARRIVED_AT_PICKUP
  PACKAGE_PICKED_UP
  IN_TRANSIT
  ARRIVED_AT_DESTINATION
  DELIVERED
  CANCELLED
  FAILED
  RETURNED
  EXPIRED
}

enum DeliveryPriority {
  STANDARD
  EXPRESS
  SAME_DAY
}

// =============================================================================
// DELIVERIES
// =============================================================================

model Delivery {
  id                 String           @id @default(uuid())
  customerId         String
  customer           CustomerProfile  @relation("CustomerDeliveries", fields: [customerId], references: [id])
  driverId           String?
  driver             DriverProfile?   @relation("DriverDeliveries", fields: [driverId], references: [id])

  pickupAddress      String
  pickupLat          Float
  pickupLng          Float
  destinationAddress String
  destinationLat     Float
  destinationLng     Float

  packageDescription  String
  packageSizeCategory String
  packageWeightKg     Float
  priority            DeliveryPriority @default(STANDARD)
  recipientName       String
  recipientPhone      String
  notes               String?

  status              DeliveryStatus @default(PENDING)

  estimatedDistanceKm  Float?
  estimatedDurationMin Int?
  estimatedPrice       Decimal? @db.Decimal(10, 2)
  finalPrice           Decimal? @db.Decimal(10, 2)

  assignmentAttempts      Int      @default(0)
  excludedDriverIds Json @default("[]")
  driverResponseDeadline  DateTime?
  driverRespondedAt       DateTime?

  cancelledById        String?
  cancelledBy          User?    @relation("CancelledByUser", fields: [cancelledById], references: [id])
  cancelledReason      String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  confirmedAt          DateTime?
  pickedUpAt           DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?

  statusHistory        DeliveryStatusHistory[]
  locations            DeliveryLocation[]
  rating               Rating?

  @@index([status])
  @@index([customerId])
  @@index([driverId])
  @@index([createdAt])
}

model DeliveryStatusHistory {
  id         String          @id @default(uuid())
  deliveryId String
  delivery   Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  fromStatus DeliveryStatus?
  toStatus   DeliveryStatus
  changedBy  String
  reason     String?
  createdAt  DateTime        @default(now())

  @@index([deliveryId, createdAt])
}

model DeliveryLocation {
  id         String   @id @default(uuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driverId   String
  lat        Float
  lng        Float
  speed      Float?
  heading    Float?
  accuracy   Float?
  recordedAt DateTime @default(now())

  @@index([deliveryId, recordedAt])
}

// =============================================================================
// RATINGS (used later, model defined now so relations exist)
// =============================================================================

model Rating {
  id         String          @id @default(uuid())
  deliveryId String          @unique
  delivery   Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  customerId String
  customer   CustomerProfile @relation("RatingsByCustomer", fields: [customerId], references: [id])
  driverId   String
  driver     DriverProfile   @relation("RatingsForDriver", fields: [driverId], references: [id])
  score      Int
  comment    String?
  createdAt  DateTime        @default(now())

  @@index([driverId])
}