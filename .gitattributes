# Force LF for all text files in the repo, regardless of OS
* text=auto eol=lf

# Explicit binary files (never touch these)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Windows-specific scripts still use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Lockfiles shouldn't be touched
pnpm-lock.yaml -text